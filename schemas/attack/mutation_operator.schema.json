{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ZJU-LLM-Safety/DARWIN/main/schemas/attack/mutation_operator.schema.json",
  "type": "object",
  "required": ["name", "dimension", "instruction"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "dimension": {
      "enum": [
        "psychological_power",
        "cognitive_logical",
        "format_structural",
        "constraint_boundary",
        "perspective_narrative"
      ]
    },
    "instruction": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
