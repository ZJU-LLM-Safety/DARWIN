{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["source_id", "raw_prompt", "disguised_prompt", "label", "attempts", "misclassified", "strategy_ids"],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "raw_prompt": {"type": "string", "minLength": 1},
    "disguised_prompt": {"type": "string", "minLength": 1},
    "label": {"type": "integer", "enum": [0, 1]},
    "attempts": {"type": "integer", "minimum": 1, "maximum": 20},
    "misclassified": {"type": "boolean"},
    "strategy_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}}
  },
  "additionalProperties": false
}
